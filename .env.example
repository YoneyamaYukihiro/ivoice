# Microsoft Entra ID (Azure AD)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Microsoft Graph (SharePoint Online / Teams calendar)
GRAPH_USER_ID=
GRAPH_CALENDAR_ID=

# Azure Communication Services (Teams 会議参加・音声配信)
ACS_CONNECTION_STRING=
# 公開 HTTPS の callback URL (ngrok / dev tunnels 等で外部から到達できること)
ACS_CALLBACK_URI=
# bot を Teams App として参加させる場合に必要 (Entra ID アプリ ID)
ACS_TEAMS_BOT_APP_ID=
# 多テナント許可 / app テナント
ACS_TEAMS_APP_TENANT_ID=
# ACS と Cognitive Services の接続が必要 (TextSource で TTS を使う場合)
ACS_COGNITIVE_SERVICES_ENDPOINT=

# Anthropic Claude (議事録要約)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ローカル Ollama (voice-reader 原稿ジェネレーター) — 未設定なら既定値を使う
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# 議事録投稿先 (none / channel / chat)
MINUTES_POST_MODE=none
MINUTES_TEAM_ID=
MINUTES_CHANNEL_ID=
MINUTES_CHAT_ID=

# Azure AI Speech (TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast
AZURE_SPEECH_VOICE=ja-JP-NanamiNeural
